# AuraGenesis Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file!

# === Core LLM ===
OLLAMA_URL=http://localhost:11434
# Or use OpenAI compatible endpoint
# OPENAI_API_KEY=sk-...

# === Owner & Personalization ===
OWNER_NAME=YourName

# === Hardware / Embodiment (optional) ===
SENSE_INTERVAL=8                    # Seconds between sensor readings
ENABLE_CAMERA=true
ENABLE_MICROPHONE=true
ENABLE_TEMPERATURE_SENSOR=false     # Requires Raspberry Pi + DS18B20
ENABLE_BLUETOOTH=true

# === Security & Limits ===
MAX_INPUT_LENGTH=2000               # Prevent prompt injection via very long inputs
RATE_LIMIT_PER_MINUTE=30            # Chat messages per minute per session

# === Advanced (use with caution) ===
ENABLE_SELF_MODIFICATION=true       # Allow Guardian-supervised code changes
DEBUG_MODE=false
